{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "token": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "create"
        },
        "rule": {
          "type": "string",
          "enum": [
            "freestyle",
            "standard"
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            }
          ]
        }
      },
      "required": [
        "type",
        "rule",
        "size"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "join"
        },
        "code": {
          "type": "string",
          "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$"
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "match"
        },
        "rule": {
          "type": "string",
          "enum": [
            "freestyle",
            "standard"
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            }
          ]
        }
      },
      "required": [
        "type",
        "rule",
        "size"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "leave"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "move"
        },
        "move": {
          "type": "object",
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19
            },
            "y": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "move"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resign"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "undo"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "undoReply"
        },
        "accept": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "accept"
      ],
      "additionalProperties": false
    }
  ]
}
