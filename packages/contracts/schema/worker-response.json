{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 15
                    },
                    {
                      "type": "number",
                      "const": 20
                    }
                  ]
                },
                "rule": {
                  "type": "string",
                  "enum": [
                    "freestyle",
                    "standard"
                  ]
                },
                "moves": {
                  "maxItems": 400,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "kind": {
                  "type": "string",
                  "const": "position"
                },
                "toMove": {
                  "type": "string",
                  "enum": [
                    "black",
                    "white"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "playing",
                    "black_win",
                    "white_win",
                    "draw"
                  ]
                }
              },
              "required": [
                "size",
                "rule",
                "moves",
                "kind",
                "toMove",
                "status"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "analysis"
                },
                "bestMove": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 19
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 19
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "score": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "perspective": {
                      "type": "string",
                      "const": "side_to_move"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "heuristic",
                        "mate"
                      ]
                    }
                  },
                  "required": [
                    "value",
                    "perspective",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "nodes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "elapsedMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "pv": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "completed",
                    "limit",
                    "cancelled",
                    "terminal"
                  ]
                },
                "evaluator": {
                  "type": "string"
                },
                "model": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "bestMove",
                "score",
                "depth",
                "nodes",
                "elapsedMs",
                "pv",
                "reason",
                "evaluator"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "about"
                },
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "protocolVersion": {
                  "type": "number",
                  "const": 1
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "freestyle",
                      "standard"
                    ]
                  }
                },
                "sizes": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 15
                      },
                      {
                        "type": "number",
                        "const": 20
                      }
                    ]
                  }
                },
                "evaluator": {
                  "type": "string"
                },
                "nnue": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "size": {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 15
                            },
                            {
                              "type": "number",
                              "const": 20
                            }
                          ]
                        },
                        "rule": {
                          "type": "string",
                          "enum": [
                            "freestyle",
                            "standard"
                          ]
                        },
                        "bytes": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "size",
                        "rule",
                        "bytes"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "name",
                "version",
                "protocolVersion",
                "rules",
                "sizes",
                "evaluator"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "stopped"
                },
                "matched": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "matched"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
