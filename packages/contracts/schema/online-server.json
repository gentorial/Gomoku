{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "welcome"
        },
        "token": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "token"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lobby"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "queued"
        },
        "rule": {
          "type": "string",
          "enum": [
            "freestyle",
            "standard"
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            }
          ]
        }
      },
      "required": [
        "type",
        "rule",
        "size"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "room"
        },
        "room": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$"
            },
            "rule": {
              "type": "string",
              "enum": [
                "freestyle",
                "standard"
              ]
            },
            "size": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 15
                },
                {
                  "type": "number",
                  "const": 20
                }
              ]
            },
            "you": {
              "type": "string",
              "enum": [
                "black",
                "white"
              ]
            },
            "players": {
              "type": "object",
              "properties": {
                "black": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "connected": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "connected"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "white": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "connected": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "connected"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "black",
                "white"
              ],
              "additionalProperties": false
            },
            "moves": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 19
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 19
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "toMove": {
              "type": "string",
              "enum": [
                "black",
                "white"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "playing",
                "black_win",
                "white_win",
                "draw"
              ]
            },
            "ending": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "five",
                    "draw",
                    "resign"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "undo": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "black",
                    "white"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "rule",
            "size",
            "you",
            "players",
            "moves",
            "toMove",
            "status",
            "ending",
            "undo"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "room"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
