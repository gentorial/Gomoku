{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "size": {
      "anyOf": [
        {
          "type": "number",
          "const": 15
        },
        {
          "type": "number",
          "const": 20
        }
      ]
    },
    "rule": {
      "type": "string",
      "enum": [
        "freestyle",
        "standard"
      ]
    },
    "moves": {
      "maxItems": 400,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "toMove": {
      "type": "string",
      "enum": [
        "black",
        "white"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "playing",
        "black_win",
        "white_win",
        "draw"
      ]
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "humanColor": {
      "type": "string",
      "enum": [
        "black",
        "white"
      ]
    },
    "thinkTimeMs": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "thinking": {
      "type": "boolean"
    },
    "analysis": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "analysis"
            },
            "bestMove": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 19
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 19
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "score": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "perspective": {
                  "type": "string",
                  "const": "side_to_move"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "heuristic",
                    "mate"
                  ]
                }
              },
              "required": [
                "value",
                "perspective",
                "kind"
              ],
              "additionalProperties": false
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "nodes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pv": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 19
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 19
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            },
            "reason": {
              "type": "string",
              "enum": [
                "completed",
                "limit",
                "cancelled",
                "terminal"
              ]
            },
            "evaluator": {
              "type": "string"
            },
            "model": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "label",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "bestMove",
            "score",
            "depth",
            "nodes",
            "elapsedMs",
            "pv",
            "reason",
            "evaluator"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "size",
    "rule",
    "moves",
    "toMove",
    "status",
    "id",
    "version",
    "humanColor",
    "thinkTimeMs",
    "thinking",
    "analysis"
  ],
  "additionalProperties": false
}
