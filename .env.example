# Environment variables are read from the process; no .env loader is required.
# Default worker path: build/dev/bin/gomoku-worker[.exe]
# GOMOKU_ENGINE_PATH=/absolute/path/to/gomoku-worker
GOMOKU_WORKERS=2
HOST=127.0.0.1
PORT=3001
# info: search summaries and GUI/model interactions; debug: shallow search details.
# off disables diagnostic logs. Restart Vite after changing the level.
GOMOKU_LOG_LEVEL=info
# Defaults to the repository's logs directory. Daily filenames use UTC dates.
# GOMOKU_LOG_DIR=/absolute/path/to/logs
